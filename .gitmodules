[submodule "zsh/plugins/fsh"]
	path = zsh/plugins/fsh
	url = https://github.com/zdharma-continuum/fast-syntax-highlighting
[submodule "delta/delta"]
	path = delta/delta
	url = https://github.com/catppuccin/delta.git
[submodule "zsh/plugins/zsh-history-substring-search"]
	path = zsh/plugins/zsh-history-substring-search
	url = https://github.com/zsh-users/zsh-history-substring-search.git
[submodule "eza/eza-themes"]
	path = eza/eza-themes
	url = https://github.com/eza-community/eza-themes
[submodule "zsh/plugins/zsh-autopair"]
	path = zsh/plugins/zsh-autopair
	url = https://github.com/hlissner/zsh-autopair.git
[submodule "zsh/plugins/zsh-autocomplete"]
	path = zsh/plugins/zsh-autocomplete
	url = https://github.com/b1nhack/zsh-autocomplete.git
[submodule "ibus/rime"]
	path = ibus/rime
	url = https://github.com/iDvel/rime-ice.git
[submodule "zsh/plugins/tokyonight.zsh-fsh"]
	path = zsh/plugins/tokyonight.zsh-fsh
	url = https://github.com/b1nhack/tokyonight.zsh-fsh.git
[submodule "tokyonight.nvim"]
	path = tokyonight.nvim
	url = https://github.com/folke/tokyonight.nvim
