{
  "$schema": "https://opencode.ai/v2/cli.json",
  "theme": {
    "name": "tokyonight",
    "mode": "dark"
  },
  "cursor": {
    "style": "block",
    "blinking": false
  },
  "prompt": {
    "editor": false,
    "paste": "compact",
    "image_preview": true
  },
  "session": {
    "sidebar": "hide",
    "scrollbar": true,
    "thinking": "hide",
    "grouping": "none",
    "image_preview": true,
    "tps": true,
    "markdown": "rendered",
    "new_location": "launch",
    "permissions": "prompt",
    "verbosity": "high"
  },
  "tabs": {
    "mode": "off"
  },
  "attention": {
    "notifications": false
  },
  "highlights": false,
  "mini": {
    "thinking": "hide",
    "tools": "hide",
    "shell_output": "hide",
    "turn_summary": "show",
    "footer": "show",
    "splash": "show",
    "work_spinner": "block-soft-slide",
    "mono": false,
    "replay": true,
    "replay_limit": 200
  }
}
